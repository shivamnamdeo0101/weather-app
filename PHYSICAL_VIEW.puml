@startuml
title Weather Prediction Microservice - Physical View

node "User Device" {
  [Next.js Frontend] as FE
}

package "Azure Kubernetes Service (AKS)" {
  folder "Weather-Cache Pod" {
    [Weather Cache Service Container] as CACHE
    [Scheduler Container] as SCHEDULER
    [Redis Container] as REDIS
  }

  folder "Weather SVC Pod" {
    [Weather-SVC Container] as SVC
    [Rate Limiter Module] as RL
  }
}

database "External OpenWeather API" as API

FE --> CACHE : HTTPS request (port 3001 -> 8081)
CACHE --> REDIS : TCP/Redis protocol
CACHE --> SVC : Internal API call
SVC --> API : HTTPS request
SCHEDULER --> REDIS : Refresh cache
CACHE --> FE : Response

@enduml
