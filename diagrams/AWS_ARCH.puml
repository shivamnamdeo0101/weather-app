@startuml
title 🌍 Global Weather App — Simplified Multi-Region Architecture

skinparam packagePadding 10
skinparam rectangle {
    RoundCorner 8
    Padding 6
}
skinparam cloud {
    RoundCorner 10
}

actor USER
cloud CF as "CloudFront (CDN)\n• Serves Frontend (Static Assets)"
rectangle R53 as "Route 53\nLatency-Based Routing"
cloud OPENWEATHER as "OpenWeather API"

' ===========================
' GLOBAL INFRASTRUCTURE
' ===========================
package "AWS Global Infrastructure" {

    package "Asia (Singapore)" {
        rectangle POD_ASIA as "Weather Pod\nAPI + Scheduler + Redis"
    }

    package "Europe (Frankfurt)" {
        rectangle POD_EU as "Weather Pod\nAPI + Scheduler + Redis"
    }

    package "Africa (South Africa)" {
        rectangle POD_AF as "Weather Pod\nAPI + Scheduler + Redis"
    }

    package "Americas (US + São Paulo)" {
        rectangle POD_US as "Weather Pod — US East"
        rectangle POD_SA as "Weather Pod — São Paulo"
    }

    package "Oceania (Sydney)" {
        rectangle POD_OC as "Weather Pod\nAPI + Scheduler + Redis"
    }
}

' ===========================
' USER → SYSTEM FLOW
' ===========================
USER --> CF : Load Website (Static Assets)
USER --> R53 : API Calls

' CDN → Backends
R53 --> POD_ASIA
R53 --> POD_EU
R53 --> POD_AF
R53 --> POD_US
R53 --> POD_SA
R53 --> POD_OC

' ===========================
' REGIONAL WEATHER FETCH
' ===========================
POD_ASIA --> OPENWEATHER
POD_EU --> OPENWEATHER
POD_AF --> OPENWEATHER
POD_US --> OPENWEATHER
POD_SA --> OPENWEATHER
POD_OC --> OPENWEATHER

@enduml
